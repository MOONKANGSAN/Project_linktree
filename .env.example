# ── Linktree 프로젝트 환경 변수 예제 ──────────────────────────────
# 이 파일을 복사해서 .env 로 사용하세요: cp .env.example .env
# .env 파일은 .gitignore에 추가되어 git에 커밋되지 않습니다.

# ── 포트 설정 (다른 프로젝트와 충돌 시 변경) ─────────────────────
FRONTEND_PORT=5173    # 브라우저 접속: http://localhost:5173 (Vite dev 서버)
BACKEND_PORT=8081     # API 서버: http://localhost:8081
MYSQL_PORT=3307       # MySQL: localhost:3307

# ── 운영 배포 전용 (docker-compose.prod.yml에서 사용) ─────────────
# 프론트엔드가 실제로 서비스되는 주소. 브라우저가 백엔드 CORS 검사를 통과하려면
# 이 값이 실제 접속 URL과 정확히 일치해야 함 (프로토콜/호스트/포트 모두)
# 예: http://<서버IP 또는 도메인>:8090
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 데이터베이스 설정 ────────────────────────────────────────────
DB_ROOT_PASSWORD=root1234
DB_NAME=linktreedb
DB_USER=linktree
DB_PASSWORD=****

# ___ DB 비밀번호 추적 불가 ____
